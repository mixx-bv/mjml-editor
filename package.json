{
  "name": "@mixx/mjml-editor",
  "version": "0.1.0",
  "description": "Standalone MJML email editor as a Web Component. Drop-in <mjml-editor> for any HTML, Inertia/Vue/React/Livewire host.",
  "type": "module",
  "main": "./dist/mjml-editor.umd.js",
  "module": "./dist/mjml-editor.es.js",
  "unpkg": "./dist/mjml-editor.iife.js",
  "jsdelivr": "./dist/mjml-editor.iife.js",
  "exports": {
    ".": {
      "import": "./dist/mjml-editor.es.js",
      "require": "./dist/mjml-editor.umd.js"
    },
    "./element": "./dist/mjml-editor.iife.js",
    "./style.css": "./dist/mjml-editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/mjml-editor.iife.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vue-tsc -b && vite build --mode lib",
    "build:plugin": "npm run build:lib && cp dist/mjml-editor.iife.js dist/mjml-editor.css ../filament-mjml-editor/resources/dist/",
    "preview": "vite preview",
    "preview:lib": "vite preview --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "mjml-browser": "^5.0.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "nodemailer": "^9.0.3",
    "quill": "^2.0.3",
    "sass": "^1.99.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.6"
  }
}
